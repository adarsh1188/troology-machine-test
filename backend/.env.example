# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== Database =====
# Local: mongodb://127.0.0.1:27017/pms
# Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/pms
MONGO_URI=mongodb://127.0.0.1:27017/pms

# ===== Auth =====
JWT_SECRET=super_secret_change_me
JWT_EXPIRES_IN=7d

# ===== CORS =====
CLIENT_URL=http://localhost:5173

# ===== File Upload =====
# STORAGE_DRIVER = local | cloudinary
STORAGE_DRIVER=local
MAX_ATTACHMENTS=3

# ===== Cloudinary (only if STORAGE_DRIVER=cloudinary) =====
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===== Seed accounts (created by `npm run seed`) =====
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@pms.com
SEED_ADMIN_PASSWORD=Admin@123

SEED_USER1_NAME=Alice Johnson
SEED_USER1_EMAIL=alice@pms.com
SEED_USER1_PASSWORD=User@123

SEED_USER2_NAME=Bob Smith
SEED_USER2_EMAIL=bob@pms.com
SEED_USER2_PASSWORD=User@123
